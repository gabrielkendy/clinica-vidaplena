# ==============================================================
# ⚠️ ESTE ARQUIVO NÃO DEVERIA ESTAR AQUI.
# Está dentro de public/ DE PROPÓSITO (lab de treino): demonstra a
# falha clássica de deploy onde o arquivo de segredos fica acessível
# pela web. Todos os valores são FICTÍCIOS.
# ==============================================================

# --- BANCO DE DADOS (onde mora tudo) ---
DB_HOST=db.vidaplena.local
DB_PORT=5432
DB_USER=admin_vidaplena
DB_PASSWORD=senha-de-exemplo-123
DB_NAME=vidaplena

# --- CACHE / SESSAO (aqui é onde DEVERIA travar as tentativas de login) ---
REDIS_URL=redis://redis.vidaplena.local:6379/0

# --- API INTERNA (automacao de agendamento e faturamento) ---
INTERNAL_API_URL=http://api-interno.vidaplena.local:8080

# --- E-MAIL OFICIAL ---
SMTP_HOST=smtp.vidaplena.local
SMTP_PORT=587
SMTP_USER=contato@vidaplena.local
SMTP_PASSWORD=email-de-exemplo-456

# --- ASSISTENTE DE IA ---
VIDA_AI_KEY=sk-vid...icio

# --- WHATSAPP OFICIAL ---
WHATSAPP_TOKEN=EAAG-EXEMPLO-FICTICIO-DE-LAB-000000000000

# --- FINANCEIRO ---
PIX_CHAVE=financeiro@vidaplena.local

# --- COFRE DE EXAMES (armazenamento dos laudos) ---
STORAGE_BUCKET=exames-vidaplena
STORAGE_REGION=sa-east-1

# --- MONITORAMENTO DE ERROS (envia o stack trace pra fora) ---
SENTRY_DSN=https://4b98bf7102a1b3c4d5e6f7a8b9c0d1e2f3a4b5c6@o123.ingest.sentry.io/4567890

# --- DEBUG LIGADO (joga detalhe interno na tela) ---
APP_DEBUG=true

# --- CONTAS DE ACESSO ---
SUPERADMIN_EMAIL=admin@vidaplena.local

# Copia de seguranca do banco (o robo roda todo dia as 2h)
BACKUP_DIR=/var/www/vidaplena/backups

# Painel interno — token de serviço da equipe (usado pela automacao do faturamento)
EQUIPE_TOKEN=tok_equipe_000
JWT_SECRET=segredo-de-exemplo-nao-use-em-producao
